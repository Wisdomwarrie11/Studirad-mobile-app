rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Collection: Courses (Recorded clinical courses & embedded videos)
    match /courses/{courseId} {
      allow read: if true;
      allow write, delete: if isValidId(courseId);
    }

    // Collection: Classes (Masterclasses, cohorts, and tutorials)
    match /classes/{classId} {
      allow read: if true;
      allow write, delete: if isValidId(classId);
    }

    // Collection: Materials (Clinical protocols, checklists, guidelines)
    match /materials/{materialId} {
      allow read: if true;
      allow write, delete: if isValidId(materialId);
    }

    // Collection: Videos (Recorded clinical session lectures)
    match /videos/{videoId} {
      allow read: if true;
      allow write, delete: if isValidId(videoId);
    }

    // Collection: Opportunities (Jobs, NHS locums, internships, scholarships)
    match /opportunities/{opportunityId} {
      allow read: if true;
      allow write, delete: if isValidId(opportunityId);
    }

    // Collection: Jobs
    match /jobs/{jobId} {
      allow read: if true;
      allow write, delete: if isValidId(jobId);
    }

    // Collection: Internships
    match /internships/{internshipId} {
      allow read: if true;
      allow write, delete: if isValidId(internshipId);
    }

    // Collection: Scholarships
    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow write, delete: if isValidId(scholarshipId);
    }

    // Collection: Locum Profiles (Locum network & availability)
    match /locum_profiles/{profileId} {
      allow read: if true;
      allow write, delete: if isValidId(profileId);
    }

    // Collection: Locums (Fallback locum collection)
    match /locums/{locumId} {
      allow read: if true;
      allow write, delete: if isValidId(locumId);
    }

    // Collection: Webinars (Recorded webinars and clinical presentations)
    match /webinars/{webinarId} {
      allow read: if true;
      allow write, delete: if isValidId(webinarId);
    }

    // Collection: Service & Research Requests
    match /requests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Collection: Tutor & Instructor Applications
    match /tutor_applications/{applicationId} {
      allow read, write: if isValidId(applicationId);
    }

    // Collection: Tutorial Requests (Private 1-on-1 bookings and custom sessions)
    match /tutorial_requests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Collection: Admin Notifications
    match /admin_notifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }

    // Collection: User Notifications
    match /notifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }

    // Collection: Tutor & One-on-One Bookings
    match /bookings/{bookingId} {
      allow read, write: if isValidId(bookingId);
    }

    // Collection: Users (User profile and nested learning progress)
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);

      // Subcollections: Completed Classes, Enrolled Courses, Saved Opportunities
      match /{allSubcollections=**} {
        allow read, write: if isValidId(userId);
      }
    }

    // Collection: Health check test connection
    match /test/{testId} {
      allow read, write: if true;
    }

    // Collection: Admin registry
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
